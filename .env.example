# Postgres connection string. For local dev, run `npx prisma dev` and paste the URL it prints.
# For production, use your Neon connection string (see README for setup).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-value"
NEXTAUTH_SECRET="replace-with-a-random-value"

# Bootstrap admin account created by the seed script (prisma/seed.ts)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-before-the-event"
